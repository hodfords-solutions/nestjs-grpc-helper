{{#hasItems directParams}}
    {{#unless isStream}}async {{/unless}}{{method}}(
    {{#each directParams}}
        {{this.name}}{{#unless this.required}}?{{/unless}}: {{this.type}}{{#if this.isArray}}[]{{/if}}{{#unless @last}}, {{/unless}}
    {{/each}}
    ): {{#if isStream}}Observable<{{returnType}}>{{else}}Promise<{{returnType}}>{{/if}} {
        {{{body}}}
    }
{{else}}
    {{#if params}}
        {{#unless isStream}}async {{/unless}}{{method}}(param: {{params}}): {{#if isStream}}Observable<{{returnType}}>{{else}}Promise<{{returnType}}>{{/if}} {
            {{{body}}}
        }
    {{else}}
        {{#unless isStream}}async {{/unless}}{{method}}(): {{#if isStream}}Observable<{{returnType}}>{{else}}Promise<{{returnType}}>{{/if}} {
            {{{body}}}
        }
    {{/if}}
{{/hasItems}}
